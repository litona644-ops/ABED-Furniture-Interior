{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Furniture or interior design product catalog item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nameEn": { "type": "string" },
        "nameBn": { "type": "string" },
        "category": { "type": "string", "enum": ["furniture", "interior"] },
        "imageUrl": { "type": "string" },
        "priceEn": { "type": "string" },
        "priceBn": { "type": "string" },
        "minPrice": { "type": "number" },
        "descriptionBn": { "type": "string" },
        "descriptionEn": { "type": "string" },
        "specsBn": { "type": "string" },
        "specsEn": { "type": "string" },
        "isTrending": { "type": "boolean" },
        "images": { "type": "string", "description": "Optional list or JSON of additional product image URLs" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "nameEn", "nameBn", "category", "imageUrl", "priceEn", "priceBn", "minPrice", "descriptionBn", "descriptionEn", "specsBn", "specsEn", "isTrending"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Dynamic website content, contacts, and designer details",
      "type": "object",
      "properties": {
        "brandNameLeft": { "type": "string" },
        "brandNameRight": { "type": "string" },
        "tagline": { "type": "string" },
        "heroBadge": { "type": "string" },
        "heroTitleBn1": { "type": "string" },
        "heroTitleBn2": { "type": "string" },
        "heroDescBn": { "type": "string" },
        "showroomAddress": { "type": "string" },
        "showroomHours": { "type": "string" },
        "phone1": { "type": "string" },
        "phone2": { "type": "string" },
        "phone3": { "type": "string" },
        "designerName": { "type": "string" },
        "designerTitle": { "type": "string" },
        "designerDesc1": { "type": "string" },
        "designerDesc2": { "type": "string" },
        "designerExpText": { "type": "string" },
        "designerDubaiText": { "type": "string" }
      },
      "required": ["brandNameLeft", "brandNameRight", "tagline", "heroBadge", "heroTitleBn1", "heroTitleBn2", "heroDescBn", "showroomAddress", "showroomHours", "phone1", "phone2", "phone3", "designerName", "designerTitle"]
    },
    "ProjectStats": {
      "title": "ProjectStats",
      "description": "Targets and milestones for project statistics chart",
      "type": "object",
      "properties": {
        "successTarget": { "type": "number" },
        "pendingTarget": { "type": "number" }
      },
      "required": ["successTarget", "pendingTarget"]
    },
    "CompletedProject": {
      "title": "CompletedProject",
      "description": "Completed and handed-over customer projects with photos and videos",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "titleEn": { "type": "string" },
        "category": { "type": "string", "enum": ["furniture", "interior", "full_project"] },
        "clientLocation": { "type": "string" },
        "completionDate": { "type": "string" },
        "description": { "type": "string" },
        "descriptionEn": { "type": "string" },
        "coverImage": { "type": "string" },
        "photos": { "type": "string", "description": "Array or JSON list of photo URLs" },
        "videos": { "type": "string", "description": "Array or JSON list of video URLs" },
        "clientName": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "title", "description", "category", "clientLocation", "completionDate"]
    },
    "VisitorRecord": {
      "title": "VisitorRecord",
      "description": "Anonymized page visit telemetry for business analytics",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ip": { "type": "string" },
        "country": { "type": "string" },
        "city": { "type": "string" },
        "device": { "type": "string", "enum": ["desktop", "mobile", "tablet"] },
        "browser": { "type": "string" },
        "os": { "type": "string" },
        "visitedPage": { "type": "string" },
        "referrer": { "type": "string" },
        "userAgent": { "type": "string" },
        "timestamp": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "visitedPage", "timestamp"]
    },
    "AdminDeviceSession": {
      "title": "AdminDeviceSession",
      "description": "Active authorized administrator session tracking",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "adminEmail": { "type": "string" },
        "deviceName": { "type": "string" },
        "browser": { "type": "string" },
        "os": { "type": "string" },
        "deviceType": { "type": "string", "enum": ["Desktop", "Mobile", "Tablet"] },
        "loginAt": { "type": "string" },
        "lastActive": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["sessionId", "adminEmail", "loginAt"]
    },
    "CustomFurnitureRequest": {
      "title": "CustomFurnitureRequest",
      "description": "Customer bespoke furniture quotation and drawing request",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "furnitureType": { "type": "string" },
        "timberType": { "type": "string" },
        "clientPhone": { "type": "string" },
        "customDimensions": { "type": "string" },
        "customNotes": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "contacted", "confirmed", "completed"] },
        "timestamp": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "furnitureType", "timberType", "clientPhone", "timestamp"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of furniture and interior products"
    },
    "/site_settings/{settingsId}": {
      "schema": "SiteSettings",
      "description": "Website customizable content and settings"
    },
    "/project_stats/{statsId}": {
      "schema": "ProjectStats",
      "description": "Customizable project success and pending targets"
    },
    "/completed_projects/{projectId}": {
      "schema": "CompletedProject",
      "description": "Handed over and completed customer projects"
    },
    "/visitor_analytics/{recordId}": {
      "schema": "VisitorRecord",
      "description": "Aggregated visitor telemetry"
    },
    "/admin_sessions/{sessionId}": {
      "schema": "AdminDeviceSession",
      "description": "Authenticated admin workstation sessions"
    },
    "/custom_furniture_requests/{requestId}": {
      "schema": "CustomFurnitureRequest",
      "description": "Customer bespoke furniture custom order inquiries"
    }
  }
}
