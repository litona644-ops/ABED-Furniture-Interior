rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny: All paths are locked by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Security & Identity Validation Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'litona644@gmail.com' ||
        request.auth.token.email == 'admin@abedfurniture.com' ||
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidProduct(data) {
      return data.nameEn is string && data.nameEn.size() <= 300
        && data.nameBn is string && data.nameBn.size() <= 300
        && data.category in ['furniture', 'interior']
        && (data.descriptionBn is string ? data.descriptionBn.size() <= 10000 : true)
        && (
          !('priceRangeBn' in data) || (data.priceRangeBn is string && data.priceRangeBn.size() <= 150)
        )
        && (
          !('priceBn' in data) || (data.priceBn is string && data.priceBn.size() <= 150)
        );
    }

    function isValidProject(data) {
      return data.title is string && data.title.size() <= 300
        && data.category in ['furniture', 'interior', 'full_project']
        && (data.description is string ? data.description.size() <= 10000 : true);
    }

    function isValidSiteSettings(data) {
      return data.brandNameLeft is string && data.brandNameLeft.size() <= 100
        && data.phone1 is string && data.phone1.size() <= 100;
    }

    function isValidVisitorRecord(data) {
      return data.visitedPage is string && data.visitedPage.size() <= 300
        && data.timestamp is number;
    }

    function isValidCustomRequest(data) {
      return data.furnitureType is string && data.furnitureType.size() <= 200
        && data.timberType is string && data.timberType.size() <= 200
        && data.clientPhone is string && data.clientPhone.size() <= 50
        && data.timestamp is number;
    }

    // 1. Products Catalog: Publicly readable; strictly Admin write/delete
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isValidId(productId) && isAdmin() && isValidProduct(request.resource.data);
      allow delete: if isValidId(productId) && isAdmin();
    }

    // 2. Site Settings: Public content readable; admin_auth document strictly protected for Admin only
    match /site_settings/{settingsId} {
      allow read: if settingsId != 'admin_auth' || isAdmin();
      allow create, update: if isValidId(settingsId) && isAdmin() && (settingsId == 'admin_auth' || settingsId == 'lockdown' || isValidSiteSettings(request.resource.data));
      allow delete: if isValidId(settingsId) && isAdmin();
    }

    // 3. Project Stats Milestones: Public read; Admin write
    match /project_stats/{statsId} {
      allow read: if true;
      allow create, update, delete: if isValidId(statsId) && isAdmin();
    }

    // 4. Completed & Handover Projects: Public read; Admin write/delete
    match /completed_projects/{projectId} {
      allow read: if true;
      allow create, update: if isValidId(projectId) && isAdmin() && isValidProject(request.resource.data);
      allow delete: if isValidId(projectId) && isAdmin();
    }

    // 5. Visitor Analytics: Public create (with rate/type validation); Admin-only read, update, delete
    match /visitor_analytics/{recordId} {
      allow create: if isValidId(recordId) && isValidVisitorRecord(request.resource.data);
      allow read, update, delete: if isValidId(recordId) && isAdmin();
    }

    // 6. Admin Device Sessions: Strictly Admin only (Fixes critical public read/write vulnerability)
    match /admin_sessions/{sessionId} {
      allow read, write: if isValidId(sessionId) && isAdmin();
    }

    // 7. Custom Furniture Order Inquiries: Public create with strict schema; Admin-only read/management
    match /custom_furniture_requests/{requestId} {
      allow create: if isValidId(requestId) && isValidCustomRequest(request.resource.data);
      allow read, update, delete: if isValidId(requestId) && isAdmin();
    }

    // 8. Admin Accounts Registry: Strictly Admin only
    match /admins/{adminId} {
      allow read, write: if isValidId(adminId) && isAdmin();
    }

    // 9. Database Connection Healthcheck
    match /test/{docId} {
      allow read: if true;
      allow write: if isValidId(docId) && isAdmin();
    }
  }
}
